{
  "name": "agentmon-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:collector": "node --test plugins/agentmon-codex/tests/collector.test.mjs plugins/agentmon-codex/tests/agentmon-loop.test.mjs",
    "test:agentmon": "node --test plugins/agentmon-codex/tests/collector.test.mjs plugins/agentmon-codex/tests/agentmon-loop.test.mjs plugins/agentmon-codex/tests/runtime-foundation.test.mjs plugins/agentmon-codex/tests/browser-extension.test.mjs plugins/agentmon-codex/tests/action-agentmon.test.mjs plugins/agentmon-codex/tests/desktop-app.test.mjs plugins/agentmon-codex/tests/desktop-marketplace.test.mjs plugins/agentmon-codex/tests/model-provider-registry.test.mjs plugins/agentmon-codex/tests/arena-harness.test.mjs plugins/agentmon-codex/tests/proof-protocol.test.mjs plugins/agentmon-codex/tests/procedure-boundary.test.mjs plugins/agentmon-codex/tests/verified-economy.test.mjs plugins/agentmon-codex/tests/verified-transitions.test.mjs plugins/agentmon-codex/tests/v4-learning-loop.test.mjs plugins/agentmon-codex/tests/pixel-snapper-security.test.mjs plugins/agentmon-codex/tests/visual-engine.test.mjs plugins/agentmon-codex/tests/moat-foundation.test.mjs plugins/agentmon-codex/tests/architecture-boundaries.test.mjs",
    "agentmon:bundle-core": "esbuild plugins/agentmon-codex/lib/agentmon-engine.ts --bundle --format=esm --platform=node --target=node22 --outfile=plugins/agentmon-codex/lib/agentmon-engine.mjs",
    "agentmon": "node --disable-warning=ExperimentalWarning plugins/agentmon-codex/scripts/agentmon.mjs",
    "agentmon:codex": "node --disable-warning=ExperimentalWarning plugins/agentmon-codex/scripts/agentmon.mjs watch",
    "agentmon:codex-live": "node plugins/agentmon-codex/scripts/collector.mjs --daemon --watch",
    "agentmon:daemon": "node --disable-warning=ExperimentalWarning plugins/agentmon-codex/scripts/agentmon-daemon.mjs",
    "agentmon:economy-server": "node --disable-warning=ExperimentalWarning plugins/agentmon-codex/scripts/agentmon-economy-server.mjs",
    "agentmon:companion": "node --disable-warning=ExperimentalWarning plugins/agentmon-codex/scripts/agentmon-companion.mjs",
    "agentmon:hook": "node plugins/agentmon-codex/scripts/universal-hook-adapter.mjs",
    "agentmon:import-chatgpt": "node plugins/agentmon-codex/scripts/import-chatgpt-export.mjs",
    "agentmon:vault-migrate": "node plugins/agentmon-codex/scripts/migrate-feed-to-vault.mjs",
    "agentmon:doctor": "node --disable-warning=ExperimentalWarning plugins/agentmon-codex/scripts/agentmon-doctor.mjs",
    "agentmon:visual": "node plugins/agentmon-codex/scripts/agentmon-visual.mjs",
    "agentmon:gallery": "node plugins/agentmon-codex/scripts/agentmon-curated-gallery.mjs",
    "agentmon:legacy-gallery": "node plugins/agentmon-codex/scripts/agentmon-visual-gallery.mjs",
    "agentmon:curated-gallery": "node plugins/agentmon-codex/scripts/agentmon-curated-gallery.mjs",
    "agentmon:curated-pack": "node plugins/agentmon-codex/scripts/build-trait-visual-pack.mjs",
    "agentmon:master-catalog": "node plugins/agentmon-codex/scripts/build-master-agentmon-catalog.mjs",
    "agentmon:app-sprites": "node plugins/agentmon-codex/scripts/build-trait-visual-pack.mjs",
    "agentmon:legacy-app-sprites": "node plugins/agentmon-codex/scripts/agentmon-app-sprites.mjs",
    "agentmon:db": "node --disable-warning=ExperimentalWarning plugins/agentmon-codex/scripts/agentmon.mjs db-init",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
